#!/bin/sh
# AgentFold pre-commit gate: one budgeted routine orchestrator owns the interval.
# Installed by automation/install.py (git config core.hooksPath automation/hooks).
# A --no-verify bypass must be reported in the session handover with a reason.
set -e

ROOT="$(git rev-parse --show-toplevel)"

echo "pre-commit: routine test gate"
python3 -I -S "$ROOT/automation/run_test_gate.py" routine --staged

echo "pre-commit: OK"
